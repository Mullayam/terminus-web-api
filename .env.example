# Server Configuration
PORT=7145
NODE_ENV=development

# Database
REDIS_URL=

# Security
JWT_SECRET=
ENCRYPTION_KEY=your_encryption_key
FRONTEND_URL=https://terminus.enjoys.in,https://editor.enjoys.in,http://localhost:5173,https://localhost:5174
#FRONTEND_URL=https://terminus.enjoys.in
TERMINAL_PASSWORD=
GEMINI_API_KEY=
MISTRAL_API_KEY=l
GROQ_API_KEY=
OPEN_ROUTER_KEY=
NVIDIA_API_KEY=

# Codeium inline completions (companion language server)
# Master switch; the companion never spawns unless this is exactly "true".
CODEIUM_ENABLED=false
# Pinned language-server release (only the 1.x line is verified).
CODEIUM_VERSION=1.20.8
CODEIUM_API_SERVER_URL=https://server.codeium.com
# Required launch dir used for RPC port discovery.
CODEIUM_MANAGER_DIR=/tmp/terminus/codeium/manager
# Version-keyed download cache.
CODEIUM_BINARY_DIR=/tmp/terminus/codeium/bin
# Point at a pre-baked binary to skip the boot-time download (recommended in prod).
CODEIUM_BINARY_PATH=
# Optional sha256 of the decompressed binary, verified on download when set.
CODEIUM_BINARY_SHA256=
# Simplest auth: one shared account key for every user.
CODEIUM_SHARED_API_KEY=
# When true, each user registers their own key via POST /api/codeium/auth.
CODEIUM_PER_USER_KEYS=false
CODEIUM_REGISTER_URL=https://api.codeium.com/register_user/
# Page a user opens to obtain their auth token (GET /api/codeium/auth/url).
CODEIUM_PROFILE_URL=https://www.codeium.com/profile
# Reject documents larger than this (matches the 400k client cap).
CODEIUM_MAX_DOCUMENT_CHARS=400000
# Per-user in-flight completion cap.
CODEIUM_MAX_CONCURRENT_PER_USER=4
# Byte-offset range conversion (§6.2); leave off until verified on real traffic.
CODEIUM_ENABLE_RANGE_CONVERSION=false